# Optional overrides for /opt/casdoor/conf/app.conf
# This file is loaded by systemd via: EnvironmentFile=-/opt/casdoor/.env

runmode=prod
httpport=8000

# Default to the PostgreSQL instance bootstrapped by scripts/deploy_systemd_release.sh.
driverName=postgres
dataSourceName=user=casdoor password=casdoor host=127.0.0.1 port=5432 sslmode=disable dbname=casdoor
dbName=casdoor

# Set these when the service is exposed behind a fixed domain or reverse proxy.
# origin=https://casdoor.example.com
# originFrontend=https://casdoor.example.com

# Redis-backed sessions are optional.
# redisEndpoint=127.0.0.1:6379

# When unset, Casdoor serves assets from ./web/build in the working directory.
# frontendBaseDir=/opt/casdoor/web/build
